# Copia este archivo como ".env" y llena tus datos.
# (El archivo .env NO se debe compartir ni subir a GitHub porque contiene tu clave.)

# Proveedor del LLM: "groq" (nube, gratis) u "ollama" (local, gratis)
PROVEEDOR_LLM=groq

# --- Opcion 1: Groq ---
# Consigue tu clave gratis en https://console.groq.com/keys
GROQ_API_KEY=pega_aqui_tu_clave
# Modelo abierto y gratuito en Groq con soporte de herramientas.
# (Groq retiro sus modelos Llama de chat; si cambia otra vez, revisa https://console.groq.com/docs/models)
MODELO_GROQ=openai/gpt-oss-120b

# --- Datos REALES (opcional) ---
# Con esta clave el agente usa precios reales de Google Shopping Mexico y
# muestra personas reales que reseñaron el producto en YouTube.
# Clave gratis en https://serpapi.com/manage-api-key  (si se deja vacia, usa datos simulados/estimados)
SERPAPI_API_KEY=

# --- Base de datos MySQL (XAMPP) ---
# El agente guarda cada precio en la tabla "resultados" de la base "analisis_compras".
# La base y la tabla se crean solas; tambien puedes usar database/analisis_compras.sql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=analisis_compras

# --- Opcion 2: Ollama (local) ---
# 1) Instala Ollama: https://ollama.com   2) En la terminal: ollama pull llama3.1
MODELO_OLLAMA=llama3.1
